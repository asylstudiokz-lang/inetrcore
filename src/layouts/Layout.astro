---
import '../styles/index.css';
import '../styles/fonts.css';
import Screensaver from '../components/Screensaver.astro';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
	schema?: string;
	canonicalURL?: string;
	keywords?: string;
	ogImage?: string;
}

const { 
	title, 
	description = "Центр Побед — Инновационный Оздоровительный Центр в Алматы. Остеопатия, коррекция прикуса Миката, лечение ран ЖКИМ и восстановление при ЗПРР.",
	noindex = false,
	schema,
	canonicalURL,
	keywords = "оздоровительный центр, Алматы, остеопатия, ЗПРР, ЗРР, коррекция прикуса, Миката, ЖКИМ, лечение ран, витамины, нутриенты",
	ogImage = "/og-image.png"
} = Astro.props;

const fullOgImage = new URL(ogImage, Astro.url.origin).toString();
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		{noindex ? (
			<meta name="robots" content="noindex, nofollow" />
		) : (
			<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		)}
		<link rel="canonical" href={canonicalURL || Astro.url.href} />
		<link rel="publisher" href="https://intercore-intech.com" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL || Astro.url.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={fullOgImage} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL || Astro.url.href} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={fullOgImage} />

		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>{title}</title>
		{schema && <script type="application/ld+json" set:html={schema} />}
		<style id="screensaver-anti-flash">
			/* Hides everything except the screensaver overlay until it is done.
			   Removed by JS in Screensaver.astro when finished. */
			body:not(.__screensaver-done) {
				overflow: hidden !important;
			}
			body:not(.__screensaver-done) > *:not(#screensaver-overlay) {
				visibility: hidden !important;
			}
		</style>
		<script is:inline>
			// If already seen this session, mark body as done immediately so site is visible
			if (sessionStorage.getItem('hasSeenScreensaver')) {
				document.addEventListener('DOMContentLoaded', function() {
					document.body.classList.add('__screensaver-done');
					var s = document.getElementById('screensaver-anti-flash');
					if (s) s.remove();
				});
			}
		</script>
	</head>
	<body class="bg-[#f2fcf8]">
		<Screensaver />
		<slot />
	</body>
</html>
