---

<div
  id="screensaver-overlay"
  style="display:none; position:fixed; inset:0; z-index:99999; background:black; width:100vw; height:100vh; overflow:hidden; align-items:center; justify-content:center;"
>
  <!-- Loading spinner shown while video buffers -->
  <div id="screensaver-spinner" style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); display:flex; flex-direction:column; align-items:center; gap:16px;">
    <div style="width:48px; height:48px; border:3px solid rgba(255,255,255,0.15); border-top-color:rgba(255,255,255,0.8); border-radius:50%; animation:spin 0.9s linear infinite;"></div>
  </div>
  <video
    id="screensaver-video"
    style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:none;"
    muted
    playsinline
    preload="auto"
  ></video>
</div>

<style>
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script is:inline>
(function() {
  if (sessionStorage.getItem('hasSeenScreensaver')) return;
  sessionStorage.setItem('hasSeenScreensaver', 'true');

  var overlay = document.getElementById('screensaver-overlay');
  var video   = document.getElementById('screensaver-video');
  var spinner = document.getElementById('screensaver-spinner');

  if (!overlay || !video) return;

  // Show black overlay immediately — blocks any site flash
  overlay.style.display = 'flex';

  var isMobile = window.innerWidth <= 768;
  video.src = isMobile
    ? '/assets/screensaver/screensaver_m.mp4'
    : '/assets/screensaver/screensaver_d.mp4';

  var hideTimer = null;

  function hideScreensaver() {
    if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }

    // Mark body as done — the CSS rule body:not(.__screensaver-done) no longer applies,
    // so site content becomes visible immediately (under the overlay)
    document.body.classList.add('__screensaver-done');
    var style = document.getElementById('screensaver-anti-flash');
    if (style) style.remove();

    // Then fade out the overlay on top
    overlay.style.transition = 'opacity 0.6s ease';
    overlay.style.opacity = '0';

    setTimeout(function() {
      overlay.style.display = 'none';
      video.pause();
      video.src = '';
    }, 650);
  }

  function startPlayback() {
    // Hide spinner, show video
    spinner.style.display = 'none';
    video.style.display = 'block';

    video.play().catch(function(e) {
      console.warn('Screensaver autoplay blocked:', e);
      hideScreensaver();
    });

    // Timer starts only after video actually begins playing
    hideTimer = setTimeout(hideScreensaver, 8000);
    video.onended = hideScreensaver;
  }

  // Wait for enough data to play smoothly
  video.addEventListener('canplaythrough', startPlayback, { once: true });

  // Fallback: if canplaythrough doesn't fire within 5s, play anyway
  var fallbackTimer = setTimeout(function() {
    video.removeEventListener('canplaythrough', startPlayback);
    startPlayback();
  }, 5000);

  video.addEventListener('canplaythrough', function() {
    clearTimeout(fallbackTimer);
  }, { once: true });

  // If video fails to load at all, just hide
  video.addEventListener('error', function() {
    clearTimeout(fallbackTimer);
    hideScreensaver();
  }, { once: true });

  video.load();
})();
</script>
